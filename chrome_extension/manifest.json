{
  "manifest_version": 3,
  "name": "FIFO Sync",
  "version": "1.2.0",
  "description": "Automatically syncs your bank transactions with FIFO in the background.",

  "permissions": [
    "tabs",
    "alarms",
    "storage",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "*://*.capitalone.com/*",
    "*://*.icicibank.com/*",
    "*://retailnetbanking.icici.bank.in/*",
    "*://*.bankofamerica.com/*",
    "https://*/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "http://localhost:*/*",
        "http://127.0.0.1:*/*",
        "https://finance-demo-hf4lgxwbvq-uc.a.run.app/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
