{
  "bank_key": "capital_one",
  "bank_display_name": "Capital One",
  "keyring_service": "fifo_bank_fetcher",
  "keyring_username_key": "capital_one_username",
  "keyring_password_key": "capital_one_password",
  "mfa_mode": "otp_interactive",
  "headless": false,
  "timeouts_ms": {
    "page_load":     30000,
    "element_wait":  10000,
    "download_wait": 60000
  },
  "navigation": {
    "logout_url": "https://www.capitalone.com/sign-out/"
  },
  "interactive_login_steps": [
    {"action": "goto",              "url":     "https://www.capitalone.com/"},
    {"action": "wait_for_url",      "pattern": "**/myaccounts.capitalone.com/**", "timeout": 300000},
    {"action": "inject_banner",     "message": "FIFO: Logged in! Click on your credit card to view transactions — the browser will close automatically."},
    {"action": "wait_for_navigation", "timeout": 120000}
  ],
  "transactions_steps": [
    {"action": "wait_for_selector", "selector": "[data-testid='purchase-list-item'], [data-testid='txn-row'], tr[class*='transaction'], li[class*='TransactionRow']", "timeout": 30000}
  ],
  "transactions_config": {
    "row_selector": "[data-testid='purchase-list-item'], [data-testid='txn-row'], tr[class*='transaction'], li[class*='TransactionRow']",
    "view_more_selector": "[data-testid='see-more-button'], button[class*='see-more'], button[class*='load-more'], a[class*='view-more']",
    "columns": {
      "date":        "[data-testid='transaction-date'], [class*='date'], td:nth-child(1)",
      "description": "[data-testid='merchant-name'], [data-testid='transaction-description'], [class*='merchant'], td:nth-child(2)",
      "amount":      "[data-testid='transaction-amount'], [class*='amount'], td:nth-child(3)"
    }
  }
}
