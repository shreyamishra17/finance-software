# Keep the Cloud Run image lean — ship only what src/serve_demo.py needs.

# Host-specific virtualenv (huge)
.venv/

# VCS / CI / editor / local tooling
.git/
.github/
.claude/
.DS_Store
deploy.sh
info.txt
*.md

# Retired code kept locally only
DEAD/

# Sensitive + local-only user data — never bake into the image
my_finance/
data/

# Client-side artifact (loaded into the user's browser, not served by backend)
chrome_extension/

# Archives / build artifacts
*.zip

# Python caches
__pycache__/
**/__pycache__/
*.pyc
